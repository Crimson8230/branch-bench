{
  "name": "branchbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "asbuild": "asc assembly/index.ts --target release",
    "build": "npm run asbuild && vite build",
    "dev": "npm run asbuild && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "measure": "npm run asbuild && node scripts/measure.mjs",
    "test": "npm run asbuild && node --test"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.9",
    "vite": "^7.1.12"
  }
}
